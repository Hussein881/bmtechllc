{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/zOSWriteBlaster.md::chunk-0004-9777f2fddbb6d3ed", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/zOSWriteBlaster.md", "section_heading": "What this does", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["This code builds a set of JCL jobs for each device that allocates extremely large datasets using the `IEBDG` exec from IBM. The JCL jobs have repeated creation and deletion steps, the number of steps is specified by the `-n` parameter, and determine how long the jobs will run for. These allocate datasets of the format `USERNAME.B######.SYSID.VOLSER`. The jobs submitted have jobnames of the format `B + DeviceAddress + counter`. The workload builds jobs on the same device until the JCL returns an allocation error, you should see one JCL ERROR job per device run against as the code hits this limit. Depending on the size of the volume, you'll see more or less jobs created. In general, volumes must be at least a mod-9 to run this workload successfully, but larger volumes are preffered to see more stress on the DASD."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.839196+00:00", "content_hash": "60211921177a10af61693b6eb1a59f5874205fecb8abd8082f4bd9b4b539bf10", "loader_route": ".md"}}
