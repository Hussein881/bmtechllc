{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/LinuxOnZ/LinuxNetworkTestSuite/perfinator.md::chunk-0008-09837c8dc7db6d1b", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/LinuxOnZ/LinuxNetworkTestSuite/perfinator.md", "section_heading": "Verbose Mode", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["Using the `--verbose` option will start the Uperf server and Uperf client in verbose mode. The stdout from both instances are returned to the Perfinator and displayed side by side in the terminal. This can be a helpful debug tool when diagnosing why a Uperf test failed to start."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.553322+00:00", "content_hash": "dc294f78d1276430cd39abbb50d007cc388a4a6c837578cb7f82bda650d20f38", "loader_route": ".md"}}
