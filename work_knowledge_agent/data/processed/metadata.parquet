{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/OperatingSystemsOnZ/LinuxOnZ/ConfigureDumpVol.md::chunk-0001-5e5276ff1149fc4c", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/OperatingSystemsOnZ/LinuxOnZ/ConfigureDumpVol.md", "section_heading": "Dump Volume Background", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["The dump volume is an additional storage volume that can be used to dump the memory content of a linux LPAR onto DASD for later failure analysis. The size of this volume must be greater than the amount of memory in the LPAR for the dump to succeed. To trigger the dump, the \"Load a dump program\" option should be selected in the LOAD task when targeting the configured partition. This will of course be disruptive to the linux partition."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.173082+00:00", "content_hash": "0c4697813d618dd916fb57e8ef1173eab8a6b827cea078f2545c0f33163c5e24", "loader_route": ".md"}}
