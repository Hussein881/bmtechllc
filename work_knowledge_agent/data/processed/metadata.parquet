{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0014-7617366019c33f4a", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "Reliability, Redundancy and Accessibility", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": [], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083643+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0015-0cda31cccc201a82", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "RAID", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["RAID has three methods of ensuring data redundancy in case of a drive failure: **mirroring, striping and parity**. Mirroring is the process of having two identical, up-to-date, copies of a dataset on two different drives. Therefore, if one drive fails, the data is preserved on the mirrored drive. In addition, because each drive can be accessed individually and don\u2019t really need to talk to each other to ensure data redundancy, mirroring typically gives higher performance to the system. However, this means that each byte of storage available to the system really requires two bytes of space, doubling the cost of the storage system without increasing the system space."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083688+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0016-c098617eacc7d9e0", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "untitled-section", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": [], "doc_type_confidence": 0.9, "section_heading_confidence": 0.3, "metadata_confidence": 0.3, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083732+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}, "metadata_validation_flags": ["metadata_confidence_below_threshold", "missing_section_heading"]}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0017-fbcedb94d8855353", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "untitled-section", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": [], "doc_type_confidence": 0.9, "section_heading_confidence": 0.3, "metadata_confidence": 0.3, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083797+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}, "metadata_validation_flags": ["metadata_confidence_below_threshold", "missing_section_heading"]}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0018-83c792d539aa54e5", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "untitled-section", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["Parity increases redundancy and enables fewer backup drives than mirroring. In the example above, for the price of four disks, I get three disks of usable space, whereas I would get two from a mirroring operation. However, calculating parity for each of the bits on the disk takes additional computation that slows down the system compared to mirroring. Additional problems arise during reconstruction, where data is rebuilt using the parity math after a drive failure. On large drives (2TB +) this process can take hours or days, and on large arrays with large drives this can take a full week. During this time, the entire array is under extreme strain performing this math, and it is highly likely that another disk will fail, at which point all the data in the array is lost."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.3, "metadata_confidence": 0.3, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083860+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}, "metadata_validation_flags": ["metadata_confidence_below_threshold", "missing_section_heading"]}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0019-8f87f869a97aa535", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "RAID 6", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": [], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083905+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0020-1e27ed5cb39e43fb", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "RAID 10", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": [], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083938+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md::chunk-0021-68ef2c2249818301", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/README.md", "section_heading": "Copy Services", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["Although RAID provides protection against a single drive failure, it doesn\u2019t prevent a disaster from wiping out an entire DS8K system and all the data inside. To prevent against data loss in these disaster scenarios, IBM has a variety of features collectively known as **Copy Services**. Copy Services can create a complex, interconnected network of storage for a variety of redundancies at various levels, and with different types of storage and equipment. Copy Services is an additional cost for customers and depending on which features they have enabled can be very costly.  However, for customers who can\u2019t afford to lose data, Copy Services is a method to make sure data is protected in all situations."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.083978+00:00", "content_hash": "faf99d7beac8e5b714712fa9bfa8767aa6cb437ad9e316abcc6a55a5ad800b7d", "loader_route": ".md"}}
