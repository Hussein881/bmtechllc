---
import { render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import { getAllPages } from '../lib/content';

export async function getStaticPaths() {
  const pages = await getAllPages();

  return pages
    // Section index pages are owned by [section]/index.astro, which renders
    // their prose above the generated page listing. Excluded here to avoid a
    // route collision on /{section}/.
    .filter((page) => !page.isIndex)
    .map((page) => ({
      // Strip leading/trailing slashes — Astro adds them back per trailingSlash config
      params: { slug: page.path.replace(/^\/|\/$/g, '') },
      props: { page, allPages: pages },
    }));
}

const { page, allPages } = Astro.props;
const { Content, headings } = await render(page.entry);
---

<DocsLayout page={page} allPages={allPages} headings={headings}>
  <Content />
</DocsLayout>
