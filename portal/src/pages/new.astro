---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS } from '../lib/page-contract';
---

<BaseLayout title="Create page" description="Create a proposed knowledge-base page for review.">
  <main id="main-content" class="authoring-page">
    <div class="authoring-heading">
      <p class="eyebrow">Authenticated authoring</p>
      <h1>Create a knowledge-base page</h1>
      <p>Submit a draft for review. Your content is committed to a branch and a pull request is opened — it is published only after that PR is approved and merged. You'll be asked for a GitHub token scoped to this repo the first time you submit.</p>
    </div>

    <form id="page-form" class="page-form" novalidate>
      <div id="form-message" class="form-message" aria-live="polite"></div>
      <div class="form-grid">
        <label>Section <select name="section" required>{SECTIONS.map((section) => <option value={section}>{section}</option>)}</select></label>
        <label>Title <input name="title" required maxlength="160" autocomplete="off" /></label>
        <label class="wide">Description <textarea name="description" required minlength="20" maxlength="500" rows="3" aria-describedby="description-help"></textarea><small id="description-help">A 20–500 character retrieval summary.</small></label>
        <label>Owner <input name="owner" required maxlength="80" placeholder="Initials or team name" /></label>
        <label class="wide">Markdown <textarea name="body" required rows="16" spellcheck="true" placeholder="# A useful title&#10;&#10;Explain the decision, procedure, or lesson."></textarea><small>Raw HTML is not accepted. Use Markdown instead.</small></label>
      </div>
      <div class="authoring-preview"><p class="eyebrow">Safe preview</p><p id="slug-preview">Proposed path: choose a title</p><article id="markdown-preview" class="prose preview-body">Your Markdown preview will appear here.</article></div>
      <div class="form-submit-row">
        <button class="btn-primary" type="submit">Create review pull request</button>
        <button class="btn-secondary" type="button" id="forget-token" hidden>Use a different GitHub token</button>
      </div>
    </form>
  </main>
</BaseLayout>

<script>
  import { createPage, slugify } from '../lib/github-content-client';
  import { hasCachedToken, clearCachedToken } from '../lib/github-token-auth';
  import type { PageFrontmatter } from '../lib/github-content-client';

  const form = document.querySelector<HTMLFormElement>('#page-form');
  const message = document.querySelector('#form-message');
  const preview = document.querySelector('#markdown-preview');
  const slugPreview = document.querySelector('#slug-preview');

  // Only meaningful once a token is held for this tab, so it stays hidden
  // until there is actually something to forget.
  const forgetBtn = document.querySelector<HTMLButtonElement>('#forget-token');
  const syncForgetBtn = () => { if (forgetBtn) forgetBtn.hidden = !hasCachedToken(); };
  syncForgetBtn();
  forgetBtn?.addEventListener('click', () => {
    clearCachedToken();
    syncForgetBtn();
    if (message) {
      message.className = 'form-message';
      message.textContent = 'Token forgotten. You will be asked for a new one on your next submit.';
    }
  });

  // Preselect the section when arriving from a section page's "Add a page" link.
  const requestedSection = new URLSearchParams(location.search).get('section');
  if (form && requestedSection && form.elements.namedItem('section')) {
    (form.elements.namedItem('section') as HTMLSelectElement).value = requestedSection;
  }

  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[character]!);
  const renderPreview = (markdown: string) => {
    const escaped = escapeHtml(markdown);
    return escaped
      .replace(/^### (.*)$/gm, '<h3>$1</h3>')
      .replace(/^## (.*)$/gm, '<h2>$1</h2>')
      .replace(/^# (.*)$/gm, '<h1>$1</h1>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\n{2,}/g, '</p><p>')
      .replace(/\n/g, '<br>');
  };
  const updatePreview = () => {
    if (!form || !preview || !slugPreview) return;
    const title = (form.elements.namedItem('title') as HTMLInputElement).value;
    const section = (form.elements.namedItem('section') as HTMLSelectElement).value;
    const slug = slugify(title);
    slugPreview.textContent = slug ? `Proposed path: content/${section}/${slug}.md` : 'Proposed path: choose a title';
    preview.innerHTML = `<p>${renderPreview((form.elements.namedItem('body') as HTMLTextAreaElement).value || 'Your Markdown preview will appear here.')}</p>`;
  };
  form?.addEventListener('input', updatePreview);
  form?.addEventListener('change', updatePreview);
  updatePreview();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !message) return;
    const data = new FormData(form);
    const section = String(data.get('section'));
    const frontmatter: PageFrontmatter = {
      title: String(data.get('title') || ''),
      description: String(data.get('description') || ''),
      owner: String(data.get('owner') || ''),
      updated: new Date().toISOString().slice(0, 10),
      // Schema defaults — kept out of the form to keep it to what a page
      // actually needs on day one. Editable later via the Edit page form.
      tags: [],
      status: 'draft',
      visibility: 'internal',
      reviewCycleMonths: 6,
      order: 50,
      related: [],
    };
    const body = String(data.get('body') || '');

    message.textContent = 'Creating your review pull request…';
    message.className = 'form-message';
    message.scrollIntoView({ behavior: 'smooth', block: 'center' });
    try {
      const result = await createPage({ section, frontmatter, body });
      message.className = 'form-message success';
      const link = Object.assign(document.createElement('a'), { href: result.url, target: '_blank', rel: 'noreferrer', textContent: `open pull request #${result.number}` });
      message.replaceChildren('Review pull request created: ', link, '.');
      message.scrollIntoView({ behavior: 'smooth', block: 'center' });
      form.reset();
      updatePreview();
    } catch (error) {
      message.className = 'form-message error';
      message.textContent = error instanceof Error ? error.message : 'The page could not be submitted.';
      message.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>
