{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Loop Dynamic Changes.md::chunk-0002-ef140dc911f0da47", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Loop Dynamic Changes.md", "section_heading": "Objective", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["As of ZoweLab v1.1.0, this automation cannot perform any varies that require SE/HMC deactivates or activates (such as SACF, LPAR removals and adds, etc.). It also doens't perform SE error checking. As ov ZoweLab v1.1.0, we only verify that activates performed successfully, not resource varies."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.809551+00:00", "content_hash": "6bdbd0559a237122b5ee0bca03a2a56c6299224f621827aba86631c683b091b1", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Loop Dynamic Changes.md::chunk-0003-33a34a70fb28cbd8", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Loop Dynamic Changes.md", "section_heading": "Automation Flow", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["At a high level, this is the process performed in each IODF change in loopDynamicChanges.py. This is performed for each IODF in your IODF list, and is looped through the number of times specified by the loop parameter. The purpose of outlining this flow is so users know how the various options will work inside the test. If any errors are found druing the sequence, error logs are written out for later analysis."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.809581+00:00", "content_hash": "6bdbd0559a237122b5ee0bca03a2a56c6299224f621827aba86631c683b091b1", "loader_route": ".md"}}
