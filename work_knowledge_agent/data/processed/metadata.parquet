{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/OperatingSystemsOnZ/zOS/New zOS Update Procedures/Update zOS.md::chunk-0005-b3e43735a660d169", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/OperatingSystemsOnZ/zOS/New zOS Update Procedures/Update zOS.md", "section_heading": "untitled-section", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["Only 12 flash copy sessions can be active at the same time in a single DS8K. If you get an error (it'll show a red \"x\" after you submit the flash), wait 5 minutes and try again. If this fails, open up a support ticket to the EWM team [EWM Site](https://w3.ibm.com/w3publisher/ibm-z-test-development-floor-ewm-guide)", "If you don't terminate the session, you will not be able to IPL z/OS, it will come back with a load failure because the DASD is still locked."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.3, "metadata_confidence": 0.3, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.205467+00:00", "content_hash": "8320f92f63a7b1f130e363feb20b7f38764994fa7728398641714cbf968f0eb8", "loader_route": ".md"}, "metadata_validation_flags": ["metadata_confidence_below_threshold", "missing_section_heading"]}
