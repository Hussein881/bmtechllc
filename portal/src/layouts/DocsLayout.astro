---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SidebarTree from '../components/SidebarTree.astro';
import TableOfContents from '../components/TableOfContents.astro';
import {
  buildBreadcrumbs,
  buildSectionTree,
  resolveRelated,
  findBacklinks,
  withBase,
  SECTION_LABELS,
  type PageRecord,
} from '../lib/content';

interface Props {
  page: PageRecord;
  allPages: PageRecord[];
  headings: MarkdownHeading[];
}

const { page, allPages, headings } = Astro.props;

const crumbs = buildBreadcrumbs(page);
const tree = buildSectionTree(allPages, page.section);

const related = page.related
  .map((slug) => resolveRelated(allPages, slug))
  .filter((p): p is PageRecord => p !== undefined);

// Incoming `related` edges — cheap to compute, genuinely useful for a KB
// where "what else references this" is a common question.
const backlinks = findBacklinks(allPages, page).filter(
  (b) => !related.some((r) => r.path === b.path)
);

const updatedISO = page.updated.toISOString().split('T')[0];
---

<BaseLayout title={page.title} description={page.description}>
  <div class="page-shell">
    {tree.length > 0 && (
      <aside class="sidebar" aria-label={`${SECTION_LABELS[page.section]} navigation`}>
        <p class="sidebar-heading">{SECTION_LABELS[page.section]}</p>
        <SidebarTree nodes={tree} currentPath={page.path} />
      </aside>
    )}

    <main id="main-content" class="content-column">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        {crumbs.map((crumb, i) => (
          <>
            {crumb.path ? (
              <a href={withBase(crumb.path)}>{crumb.label}</a>
            ) : (
              <span>{crumb.label}</span>
            )}
            {i < crumbs.length - 1 && <span class="sep" aria-hidden="true">/</span>}
          </>
        ))}
      </nav>

      {page.status === 'draft' && (
        <div class="status-banner banner-draft" role="status">
          <strong>Draft</strong>
          This page is work in progress. Treat its contents as unverified.
        </div>
      )}

      {page.status === 'archived' && (
        <div class="status-banner banner-archived" role="status">
          <strong>Archived</strong>
          Kept for historical reference. It may describe how we used to work,
          not how we work now.
        </div>
      )}

      {page.isStale && (
        <div class="status-banner banner-stale" role="status">
          <strong>Review overdue</strong>
          Last updated {page.monthsSinceUpdate} months ago; this page is on a
          {' '}{page.reviewCycleMonths}-month review cycle.
          {page.owner} owns it.
        </div>
      )}

      <div class="page-meta">
        <span>Updated <time datetime={updatedISO}>{updatedISO}</time></span>
        <span>Owner: {page.owner}</span>
        {page.visibility === 'shareable' && (
          <span class="badge-shareable" title="Reviewed as safe to share outside the firm">
            Shareable
          </span>
        )}
        {page.tags.length > 0 && <span class="tags">{page.tags.join(' · ')}</span>}
      </div>

      <article class="prose">
        <slot />
      </article>

      {related.length > 0 && (
        <aside class="related" aria-labelledby="related-heading">
          <h2 id="related-heading">Related</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={withBase(r.path)}>{r.title}</a>
                <span class="related-desc">{r.description}</span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      {backlinks.length > 0 && (
        <aside class="related backlinks" aria-labelledby="backlinks-heading">
          <h2 id="backlinks-heading">Referenced by</h2>
          <ul>
            {backlinks.map((b) => (
              <li>
                <a href={withBase(b.path)}>{b.title}</a>
                <span class="related-desc">{SECTION_LABELS[b.section]}</span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <div class="page-actions">
        <a class="btn-secondary" href={withBase(`${page.path.replace(/\/$/, '')}.md`)}>
          View source
        </a>
        <button
          class="btn-secondary"
          id="copy-md"
          data-md-url={withBase(`${page.path.replace(/\/$/, '')}.md`)}
        >
          Copy as Markdown
        </button>
      </div>
    </main>

    <aside class="toc-rail">
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <script>
    const btn = document.getElementById('copy-md');
    btn?.addEventListener('click', async () => {
      const url = (btn as HTMLElement).dataset.mdUrl!;
      const label = btn.textContent;
      try {
        const res = await fetch(url);
        await navigator.clipboard.writeText(await res.text());
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = label), 1600);
    });
  </script>
</BaseLayout>
