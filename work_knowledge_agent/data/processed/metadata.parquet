{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/SE_Tools/EST_Tools/error_log_viewer/README.md::chunk-0001-e9e1746cfbe13e13", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/SE_Tools/EST_Tools/error_log_viewer/README.md", "section_heading": "What is the Error Log Viewer?", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["## What is the Error Log Viewer?", "This utilization tool will scan through system logs for error entries and other informational high flying SRCs."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.670272+00:00", "content_hash": "ec5c1ddee7c76e2b124fc38c563c1901acbdd275530e2ce549e5acad106bc060", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/SE_Tools/EST_Tools/error_log_viewer/README.md::chunk-0002-702730ce1ec2fc44", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/SE_Tools/EST_Tools/error_log_viewer/README.md", "section_heading": "How is the Error Log Viewer structured?", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["## How is the Error Log Viewer structured?", "It contains an user defined error list file and additonal GREP user specified search parameters. It is recommended to include the filter in single quotes. This can be any Perl Regular Expression.  Whatever is specified will be included in the error list. This will not modify the default list.err file.", "New Log enteries will read a file that stores the last time the program was run, and will only return the new data since that timestamp.  The file is located in ./html/last_time_scanned.txt. The iFrames default is to be maximized on the current SE version. The other option is to format the iframes for a W500 notebook at resolution setting of 1920/1200. It also contains an Offline Mode that will make HTML pages for all the expanded logs and allow the user to view the standard output plus all error data when not on the SE."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.670311+00:00", "content_hash": "ec5c1ddee7c76e2b124fc38c563c1901acbdd275530e2ce549e5acad106bc060", "loader_route": ".md"}}
