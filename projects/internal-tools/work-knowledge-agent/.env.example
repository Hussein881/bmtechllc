# Work Knowledge Agent LLM provider configuration
# Set WKA_LLM_PROVIDER to select the API backend.
# Supported values: watsonx, anthropic

WKA_LLM_PROVIDER=watsonx

# Watsonx credentials
# Reuses the same Watson credential variable names used by the IML agent.
DEBUG_AGENT_LLM_WATSONX_PROJECT_ID=
DEBUG_AGENT_LLM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
DEBUG_AGENT_LLM_WATSONX_APIKEY_FILE=~/.config/iml-agent/apikey.json
DEBUG_AGENT_LLM_IAM_TOKEN_URL=https://iam.cloud.ibm.com/identity/token
WKA_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WKA_WATSONX_API_VERSION=2024-03-14
WKA_WATSONX_PROMPT_VERSION=phase3-watsonx-v1
WKA_WATSONX_MAX_RETRIES=2
WKA_WATSONX_RETRY_BACKOFF_SECONDS=1.0

# Anthropic Claude credentials
WKA_ANTHROPIC_API_KEY=
WKA_ANTHROPIC_APIKEY_FILE=~/.config/iml-agent/anthropic_apikey.json
WKA_ANTHROPIC_MODEL_ID=claude-3-5-sonnet-20241022
WKA_ANTHROPIC_API_VERSION=2023-06-01
WKA_ANTHROPIC_PROMPT_VERSION=phase3-anthropic-v1
WKA_ANTHROPIC_BASE_URL=https://api.anthropic.com
WKA_ANTHROPIC_MAX_RETRIES=2
WKA_ANTHROPIC_RETRY_BACKOFF_SECONDS=1.0
