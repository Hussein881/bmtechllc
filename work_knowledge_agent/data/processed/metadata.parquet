{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/EST_Acceptance_Test/README.md::chunk-0001-df981ae4f66dd625", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/EST_Acceptance_Test/README.md", "section_heading": "Daily Driver Acceptance", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["EST daily driver (DD) acceptance testing is accomplished by automated, self-checking code that can be initiated by the zFW development continuous integration process. The tests rely on a TOAD runtime environment.  This runtime is called by the zFW CI Jenkins process after the daily driver is loaded onto the target EST primary and alternate SEs.  In the language of DD testing, EST tests are tier three, of three tiers.  Tier one is subsystem integration testing and tier two are system integration tests that automatically cause the DD snapshot to be declared status red, i.e. failed, on the [DD dashboard](https://dd-dashboard.dal1a.cirrus.ibm.com/#/driver-status/D6X_HEAD)."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.089615+00:00", "content_hash": "d9ca4a2416c029e07be7f722c6ccaba2b3fa9e08ecdfb565ff67748bfaf93cd2", "loader_route": ".md"}}
