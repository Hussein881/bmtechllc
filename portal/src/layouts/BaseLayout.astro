---
import '../styles/global.css';
import Search from '../components/Search.astro';
import { SECTIONS, SECTION_LABELS, withBase } from '../lib/content';

interface Props {
  title: string;
  description: string;
  /** Emitted as JSON-LD; omit for non-article pages. */
  jsonLd?: Record<string, unknown>;
  bodyClass?: string;
}

const { title, description, jsonLd, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title} — BenchmarkTech</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      // Set theme before first paint to avoid a flash.
      const stored = localStorage.getItem('theme');
      const preferred = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = preferred;
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header">
      <a href={withBase('/')} class="site-name">BenchmarkTech</a>
      <nav class="site-nav" aria-label="Main navigation">
        {SECTIONS.map((section) => (
          <a
            href={withBase(`/${section}/`)}
            aria-current={Astro.url.pathname.includes(`/${section}/`) ? 'page' : undefined}
          >
            {SECTION_LABELS[section]}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <Search />
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} BenchmarkTech LLC</p>
      <p class="footer-machine">
        Machine-readable:
        <a href={withBase('/llms.txt')}>llms.txt</a> ·
        <a href={withBase('/llms-full.txt')}>llms-full.txt</a> ·
        <a href={withBase('/index.json')}>index.json</a>
      </p>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
