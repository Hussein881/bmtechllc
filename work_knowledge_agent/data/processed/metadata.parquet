{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Activate Sysplex Wide.md::chunk-0004-ea880f5625b98dd3", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Activate Sysplex Wide.md", "section_heading": "Logging", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": [], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.804448+00:00", "content_hash": "50102de54eef79f19ac30f0c6363d82753f48df8921ab362c1b393b5ddfb4390", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Activate Sysplex Wide.md::chunk-0005-6cb4336dc6cbf039", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Activate Sysplex Wide.md", "section_heading": "What is it doing under the covers?", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["The automation will determine what LPARs exist in your sysplex, and what CPC's they are associated with. Then, it will reserve the first LPAR of each CPC for hardware activation, and perform software activations on all other LPARs, going one at a time and checking if any didn't activate. Then, it will activate each CPC one at a time.  The script will error out if any activation results in the LPAR not being on the expected IODF."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.804482+00:00", "content_hash": "50102de54eef79f19ac30f0c6363d82753f48df8921ab362c1b393b5ddfb4390", "loader_route": ".md"}}
{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Activate Sysplex Wide.md::chunk-0006-d4878a9af2e930b1", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/Automation/ZoweLab/Tools/HCD Tools/Activate Sysplex Wide.md", "section_heading": "What happens when/if it breaks?", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "readme", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "md"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["If the automation breaks in a way it can detect, it will create an error log file on your 3270 OE container, and tell you an error has occurred. Please [write a Github](../../../README.md#opening-issues) defect if this happens, including what container you are running from."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.9, "metadata_confidence": 0.9, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:57.804507+00:00", "content_hash": "50102de54eef79f19ac30f0c6363d82753f48df8921ab362c1b393b5ddfb4390", "loader_route": ".md"}}
