# Public origin of the portal, with no trailing slash.
ALLOWED_ORIGIN=https://YOUR-ORG.github.io
# GitHub App credentials. Keep these only in the service's secret store.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_OWNER=YOUR-ORG
GITHUB_REPO=bmtechllc
# OIDC issuer details for the identity provider that protects page creation.
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=bmtech-page-authoring
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# Comma-separated stable OIDC `sub` claim values permitted to author pages.
# Wildcards are rejected. Add/remove users through the service secret store.
OIDC_ALLOWED_SUBJECTS=provider|user-id-1,provider|user-id-2
