{"chunk_id": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/Sharkuterie Board DASD Health Checker::chunk-0001-2804d2f10851a456", "source_file": "/Users/anwarh/Desktop/IBM/Automation/Agent/work_knowledge_agent/data/raw/work_IBM/main-EST-Users-Guide/EST-User-Guide-main/CommonProcedures/DASD Procedures/Sharkuterie Board DASD Health Checker", "section_heading": "untitled-section", "project": "work_knowledge_agent", "machine": "unknown", "component": "unknown", "mode": "unknown", "doc_type": "document", "date": "2026-07-04", "owner": "unknown", "tags": ["ingested", "unknown"], "confidentiality_level": "internal", "extracted_commands": [], "extracted_errors": ["11.\tWait for the job to run, will take a couple of minutes. If any step fails, you can expand the failed step and look for error messages. If no steps fail, the DS8K\u2019s look good.", "12.\tIf steps fail, feel free to reach out to Eric Reid or Janet Kayarian. You can give them the output of the failed step to help them in their debug process.", "13.\tIf all steps succeed but you think you still have a problem, please note that additional data will be needed from the rest of your environment to determine the failure."], "doc_type_confidence": 0.9, "section_heading_confidence": 0.3, "metadata_confidence": 0.3, "provenance": {"loader_version": "2.0.0", "chunker_version": "2.0.0", "extractor_version": "2.0.0", "ingested_at": "2026-07-04T02:09:58.085361+00:00", "content_hash": "20c4a14122d6d9720bc3f52b45db7cc1fdecdfd763609944512ab72b499b1b39", "loader_route": "fallback:log"}, "metadata_validation_flags": ["metadata_confidence_below_threshold", "missing_section_heading"]}
