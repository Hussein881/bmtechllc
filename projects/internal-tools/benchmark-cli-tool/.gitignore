.venv/
.env
.env.local
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Python build and coverage output.
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Runtime telemetry and regenerated reports.
artifacts/
usage_log.csv

# Local company exports and retired source material. Sanitized test fixtures live in tests/fixtures/.
data/documents/*
data/archive/

# Reviewed production evaluation labels may contain confidential business context.
data/evaluation/golden_queries.json

# Local Docker overrides may contain credentials.
docker-compose.override.yml
docker-compose.override.yaml

# Manual database exports/backups. Versioned SQL migrations remain tracked.
backups/
*.dump
*.backup
*.sql.gz

# Supabase CLI internal state. Keep Supabase config and migrations tracked.
supabase/.temp/
supabase/.branches/
supabase/signing_keys.json
